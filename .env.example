# Supabase (Project Settings → API). Without these the site runs with sample data,
# and accounts, events and the contact form stay hidden.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…); the legacy anon key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets — mark both as "Sensitive" in Vercel and NEVER give them a NEXT_PUBLIC_ name.
# Secret key (sb_secret_…, Project Settings → API Keys): lets the server save masjid search results in Supabase
# so repeat and preloaded searches are instant. Without it, searches still work, just slower.
SUPABASE_SECRET_KEY=
# Any long random string. Vercel sends it with the daily refresh job; requests without it are rejected.
CRON_SECRET=

# Daily learning and scholar emails: Resend API key and a sender on a verified domain.
RESEND_API_KEY=
SCHOLAR_FROM_EMAIL=
# Optional separate sender for daily learning; falls back to SCHOLAR_FROM_EMAIL.
DAILY_FROM_EMAIL=
